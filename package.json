{
  "name": "moneydevkit-nextjs-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace for Money Dev Kit web packages.",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run --if-present test",
    "lint": "pnpm -r run --if-present lint",
    "clean": "pnpm -r run --if-present clean",
    "typecheck": "pnpm run build && pnpm -r run --if-present typecheck",
    "cypress:run": "cypress run --spec cypress/e2e/vercel-demo.cy.ts",
    "test:e2e": "concurrently -k -s first \"pnpm --filter mdk-nextjs-demo run dev -- --hostname 0.0.0.0 --port 3010\" \"wait-on http://localhost:3010 && CYPRESS_BASE_URL=http://localhost:3010 cypress run --spec cypress/e2e/checkout.cy.ts\""
  },
  "optionalDependencies": {
    "@moneydevkit/lightning-js-linux-arm64-gnu": "0.1.87",
    "@moneydevkit/lightning-js-linux-x64-gnu": "0.1.87"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cypress": "14.5.4",
    "wait-on": "^8.0.2"
  },
  "pnpm": {
    "overrides": {
      "@orpc/client@<=1.13.5": ">=1.13.6 <2",
      "shell-quote@<=1.8.4": ">=1.9.0 <2",
      "tar@<=7.5.18": ">=7.5.19 <8",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5 <8",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6 <5",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0 <8",
      "undici@>=6.0.0 <6.28.0": ">=6.28.0 <7",
      "undici@>=5.0.0 <5.29.0": ">=5.29.0 <6",
      "brace-expansion@>=1.0.0 <1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1 <5",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "postcss@<=8.5.22": ">=8.5.23 <9",
      "axios@>=1.0.0 <1.16.0": ">=1.16.0 <2",
      "qs@>=6.7.0 <=6.15.1": ">=6.15.2 <7",
      "uuid@<11.1.1": ">=11.1.1 <12",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0 <3",
      "@babel/core@<=7.29.0": ">=7.29.6 <8",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1 <0.29",
      "@tootallnate/once@<2.0.1": ">=2.0.1 <3",
      "next@>=16.0.0 <16.2.11": ">=16.2.11 <17"
    }
  }
}